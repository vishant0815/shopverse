# Copy this file to .env and change the values before running.
# Never commit your real .env file.

# PostgreSQL
POSTGRES_USER=shopverse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopverse
POSTGRES_PORT=5432

# One database per microservice (comma-separated)
SERVICE_DATABASES=users_db,products_db,orders_db,payments_db,inventory_db

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379
