# Template for your local .env file. Never commit the real .env.
#
# Quickest way to get a working .env with random secret keys:
#   python scripts/create_env.py
#
# Or copy this file to .env by hand and replace every "change-me" value.
# The services refuse to start while the secret keys are still "change-me".

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=shopverse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopverse
POSTGRES_PORT=5432
# One database per microservice (comma-separated). Only used the first time
# the Postgres volume is created.
SERVICE_DATABASES=users_db,products_db,orders_db,payments_db,inventory_db

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Shared settings
# ---------------------------------------------------------------------------
# Keep false unless you need debug pages. Debug mode also allows short keys.
DJANGO_DEBUG=false
# Must stay false over plain http://localhost, or browsers won't send the refresh cookie.
REFRESH_COOKIE_SECURE=false

# Secret keys: at least 32 characters each, all different. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# Shared by every service: the users service signs JWTs with it, the others verify them.
JWT_SIGNING_KEY=change-me

# ---------------------------------------------------------------------------
# Users service       http://localhost:8001
# ---------------------------------------------------------------------------
USERS_PORT=8001
USERS_SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# Products service    http://localhost:8002
# ---------------------------------------------------------------------------
PRODUCTS_PORT=8002
PRODUCTS_SECRET_KEY=change-me
# Load demo categories and products on start
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Orders service      http://localhost:8003
# ---------------------------------------------------------------------------
ORDERS_PORT=8003
ORDERS_SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# Payments service    http://localhost:8004  (API docs at /docs)
# ---------------------------------------------------------------------------
PAYMENTS_PORT=8004
# "fake" works with no Stripe account: complete payments with the simulate endpoint.
# "stripe" needs test-mode keys from https://dashboard.stripe.com/test/apikeys
PAYMENT_PROVIDER=fake
# Test keys only (sk_test_...). Live keys are refused.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8004/api/v1/webhooks/stripe` (whsec_...)
STRIPE_WEBHOOK_SECRET=
