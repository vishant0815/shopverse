# Copy this file to .env and change the values before running.
# Never commit your real .env file.

# PostgreSQL
POSTGRES_USER=shopverse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopverse
POSTGRES_PORT=5432

# One database per microservice (comma-separated)
SERVICE_DATABASES=users_db,products_db,orders_db,payments_db,inventory_db

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# Shared Django settings
# Keep DJANGO_DEBUG=false unless you need Django's debug pages.
DJANGO_DEBUG=false
# Must stay false over plain http://localhost, or browsers won't send the refresh cookie.
REFRESH_COOKIE_SECURE=false

# Secret keys: at least 32 characters each. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# Shared by every service: the users service signs JWTs with it, the others verify them.
JWT_SIGNING_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# Users service
USERS_PORT=8001
USERS_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters

# Products service
PRODUCTS_PORT=8002
PRODUCTS_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
# Load demo categories and products on start
SEED_DEMO_DATA=true

# Orders service
ORDERS_PORT=8003
ORDERS_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
