# Only needed when running `npm run dev` outside Docker.
# Where each backend service runs (these are the defaults).
USERS_API_URL=http://localhost:8001
PRODUCTS_API_URL=http://localhost:8002
ORDERS_API_URL=http://localhost:8003
PAYMENTS_API_URL=http://localhost:8004

