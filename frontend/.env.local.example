# Only needed when running `npm run dev` outside Docker (these are the defaults).
# Where the API gateway runs (Docker Compose publishes it on 3000).
GATEWAY_URL=http://localhost:3000
# Server-rendered catalogue pages read the products service directly.
PRODUCTS_API_URL=http://localhost:8002

# Only needed with PAYMENT_PROVIDER=stripe: your Stripe *publishable* test key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
